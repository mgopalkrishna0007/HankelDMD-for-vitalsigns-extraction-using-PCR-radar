def calculate_metrics(true_signal, reconstructed):
    """Calculate MSE, RMSE, NRMSE, Pearson correlation, and MAE"""
    # Mean Squared Error
    mse = np.mean((true_signal - reconstructed)**2)
    
    # Root Mean Squared Error
    rmse = np.sqrt(mse)
    
    # Normalized Root Mean Squared Error
    nrmse = rmse / np.std(true_signal)
    
    # Pearson Correlation Coefficient
    pearson_r = np.corrcoef(true_signal, reconstructed)[0, 1]
    
    # Mean Absolute Error
    mae = np.mean(np.abs(true_signal - reconstructed))
    
    return mse, rmse, nrmse, pearson_r, mae

